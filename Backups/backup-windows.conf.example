# Windows backup configuration
#
# Each entry is:
#   "IP|WindowsPath"
#
# Windows paths can be written naturally:
#   C:\Users
#   D:\
#   E:\Projekte
#
# The script converts the Windows path to an SFTP path for sshfs.

WINDOWS_USER="backup"

WINDOWS_SOURCES=(
    "192.168.1.10|C:\Users"
    "192.168.1.11|D:\"
    "192.168.1.12|E:\Projekte"
    "192.168.1.13|C:\"
)

BACKUP_DIR="/srv/backups/windows"
LOG_DIR="/var/log/backups/windows"

FULL_EVERY_DAYS=7
RETENTION_DAYS=30
DRY_RUN=false
SSHFS_TIMEOUT=15

# Optional SSHFS options, e.g.:
# SSHFS_OPTS="-o IdentityFile=/root/.ssh/windows-backup"
SSHFS_OPTS=""

RSYNC_EXTRA_OPTS=""
LOCK_FILE="$BACKUP_DIR/.backup-windows.lock"
